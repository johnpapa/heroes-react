{
  "name": "heroes-react",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "lint": "eslint \"src/**/*.{js,jsx}\" --quiet",
    "quick": "concurrently \"npm run backend\" \"npm start\"",
    "cypress": "npx cypress open",
    "e2e": "concurrently \"npm run quick\" \"npm run cypress\"",
    "backend": "json-server --watch db.json --routes routes.json --port 8627 --middlewares ./node_modules/json-server-reset"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8627/",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.4",
    "axios": "^1.7.9",
    "bulma": "^1.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^8.1.3",
    "react-router-dom": "^7.14.2",
    "react-scripts": "5.0.1",
    "redux": "^4.2.1",
    "redux-saga": "^1.3.0",
    "redux-thunk": "^2.4.2",
    "sass": "^1.83.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cypress": "^13.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "json-server": "^0.17.4",
    "json-server-reset": "^1.6.0",
    "prettier": "^3.4.2"
  }
}
